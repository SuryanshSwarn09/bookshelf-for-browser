{
  "manifest_version": 3,
  "name": "Bookshelf - Glassmorphic Startpage Dashboard",
  "version": "1.0.0",
  "description": "An elegant iOS-inspired glassmorphic new tab dashboard and bookmark manager.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Bookshelf Dashboard"
  }
}
